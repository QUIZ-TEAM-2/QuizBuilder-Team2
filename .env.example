# Copy this file to .env.local for local development.
# You normally don't need to fill these in by hand: running `npx convex dev`
# and choosing the existing "QuizBuilder P16" project writes the first two
# into .env.local for you.

# Your personal Convex dev deployment (set by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Optional: only needed if you run Google sign-in locally.
# Backend auth secrets (JWT_PRIVATE_KEY, JWKS, SITE_URL, AUTH_GOOGLE_*,
# AUTH_SENDGRID_*, ADMIN_BOOTSTRAP_SECRET) live in Convex environment
# variables, NOT in this file. See the README.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
